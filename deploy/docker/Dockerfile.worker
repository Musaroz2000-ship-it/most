# Managed-deployment image for the grok-bridge worker.
# Build context = repository root. The platform injects the service-account
# token (MISTRAL_SA_TOKEN_PATH) and connection settings at runtime; the xAI key
# comes from the workspace secret xai_api_key bound as XAI_API_KEY.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./pyproject.toml
COPY src ./src
RUN pip install --no-cache-dir .
ENV PYTHONPATH=/app/src
CMD ["python", "-m", "worker.entrypoints.worker"]
